# ---------------------------------------------------------------------------
# ContentBridge configuration. Copy to .env and fill in secrets.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Postgres --------------------------------------------------------------------
POSTGRES_USER=contentbridge
POSTGRES_PASSWORD=contentbridge
POSTGRES_DB=contentbridge
# Host-side URL (running the API outside docker). Inside compose the api
# service overrides the host to `postgres`.
DATABASE_URL=postgresql+asyncpg://contentbridge:contentbridge@localhost:5544/contentbridge

# Qdrant ----------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contentbridge_chunks

# Auth ------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-replace-me-with-48-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Storage ---------------------------------------------------------------------
# `local` writes under STORAGE_LOCAL_DIR; the interface is S3-shaped so this
# can become minio/s3 later without touching call sites.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# LLM provider ----------------------------------------------------------------
# gemini | openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Used when LLM_PROVIDER=openai_compatible (OpenAI, Ollama, vLLM, OpenRouter...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings ------------------------------------------------------------------
# local_fastembed keeps retrieval working with no network at demo time.
EMBEDDING_PROVIDER=local_fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Frontend --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
